-- Quartus II generated Memory Initialization File (.mif)

WIDTH=8;
DEPTH=64;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
	[00..09]  :   FF;
	0A  :   AA;
	0B  :   BB;
	0C  :   CC;
	0D  :   DD;
	0E  :   EE;
	[0F..3F]  :   FF;
END;
